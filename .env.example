# Copy to .env and adjust as needed:
#   cp .env.example .env

# Official image tag: https://hub.docker.com/r/vllm/vllm-openai/tags
# CUDA 12.9 build: default v0.27.1 is CUDA 13, which GeForce + driver 535 cannot run.
VLLM_IMAGE_TAG=v0.27.1-cu129

# Host port for the OpenAI-compatible API
VLLM_PORT=8000

# Serve config under vllm/configs/, mounted at /etc/vllm/config.yaml
#   bf16.yaml    — original Qwen3-0.6B (bfloat16)
#   w4a16.yaml   — GPTQ W4A16 checkpoint (notebooks/01-quantize-gptq.ipynb)
VLLM_CONFIG=bf16.yaml

# --- Observability (Prometheus + Grafana) ---
# Prometheus scrapes vLLM's /metrics; Grafana auto-provisions the vLLM dashboard.
PROMETHEUS_IMAGE_TAG=v3.1.0
PROMETHEUS_PORT=9090

GRAFANA_IMAGE_TAG=11.4.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Logs (Loki + Alloy) ---
# Alloy tails Docker container logs into Loki; Grafana queries them.
LOKI_IMAGE_TAG=3.3.2
LOKI_PORT=3100
ALLOY_IMAGE_TAG=v1.5.1

# --- Traces (Tempo) ---
# vLLM emits OTLP traces to Alloy, which forwards them to Tempo.
TEMPO_IMAGE_TAG=2.6.1
TEMPO_PORT=3200

# --- Infra exporters (scraped by Prometheus; no host ports) ---
# node-exporter: host CPU/mem/disk/net. cAdvisor: per-container usage.
# dcgm-exporter: NVIDIA GPU metrics (pin DCGM 3.3.x for driver 535).
NODE_EXPORTER_IMAGE_TAG=v1.8.2
CADVISOR_IMAGE_TAG=v0.60.5
DCGM_EXPORTER_IMAGE_TAG=3.3.9-3.6.1-ubuntu22.04
